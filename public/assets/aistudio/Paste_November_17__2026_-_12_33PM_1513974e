export class PreviewDataAdapter
  implements AmanDataAdapter {

  async getVault() {
    return loadPreviewVault();
  }

  async createItem(
    input: VaultItemInput
  ) {
    const vault =
      await loadPreviewVault();

    const item = {
      ...input,
      id: crypto.randomUUID(),
      createdAt:
        new Date().toISOString(),
      updatedAt:
        new Date().toISOString(),
