# 54. DANGEROUS URL BLOCKING

Block:

```text
javascript:
vbscript:
data:
file:
blob:
about:
```

Example:

```ts
export function normalizeUrl(
  raw: unknown
): string | null {
  const value = safeString(raw).trim();

  if (!value)
    return null;

  const lowered = value.toLowerCase();

  if (
    /^(javascript|vbscript|data|file|blob|about):/
      .test(lowered)
  ) {
    return null;
  }

  const candidate =
    /^https?:\/\//i.test(value)
      ? value
      : `https://${value}`;

  try {
    const url = new URL(candidate);

    if (
      url.protocol !== "https:" &&
      url.protocol !== "http:"
    ) {
      return null;
    }

    return url.href;
  } catch {
    return null;
  }
}
```

Web version:

