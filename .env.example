# AMAN Mode: "preview" for Google AI Studio preview, "production" for Node.js + MySQL
VITE_APP_MODE=preview

# Production Server Configuration
NODE_ENV=production
PORT=3000
PUBLIC_ORIGIN=https://example.com

# MySQL / MariaDB Configuration (Production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=aman
DB_USER=aman_app
DB_PASSWORD=CHANGE_ME

# Session & Security Secret (Production)
SESSION_SECRET=CHANGE_ME

# One-Time Production Bootstrap Token (Generate long random token before first setup, remove after initialization)
AMAN_BOOTSTRAP_TOKEN=

# WebAuthn / Passkeys Configuration (Production requires HTTPS origin matching RP ID)
WEBAUTHN_RP_NAME=Aman Rayan
WEBAUTHN_RP_ID=aman.example.com
WEBAUTHN_ORIGIN=https://aman.example.com

